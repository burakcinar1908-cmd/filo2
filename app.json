{
  "expo": {
    "name": "Tagsimetre",
    "slug": "tagsimetre-mobile",
    "version": "1.0.0",
    "scheme": "tagsimetre",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tagsimetre.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "Mesai aktifken aracınızın konumunu Tagsimerte sistemine iletmek için konum izni gereklidir.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mesai aktifken, uygulama arka plandayken de aracınızın konumunu iletebilmek için 'Her Zaman İzin Ver' gereklidir."
      }
    },
    "android": {
      "package": "com.tagsimetre.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mesai aktifken, uygulama arka plandayken de aracınızın konumunu iletebilmek için konum izni gereklidir.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": ""
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61d39ad1-a1ef-401a-a532-030ea2a8be8c"
      }
    }
  }
}
